DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<dbname>"
# Service role / secret key (server-only)
SUPABASE_SERVICE_ROLE="sb_secret_<your_service_role>"
# Client-side publishable key (safe to expose to frontend)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<your_publishable_key>"
SESSION_SECRET="a_long_random_string_used_to_sign_sessions"
# Replit / OIDC client ID used for auth flows
REPL_ID="<your_repl_client_id>"
